# Copy this file to .env and fill in your values
# .env is excluded from git

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
# Port for HTTP. When TLS certs are present, this redirects to HTTPS.
FRONTEND_PORT=80
# Port for HTTPS (only used when cert.pem + key.pem exist in config/certs/).
HTTPS_PORT=443
# Set to 1 to generate a new random password on next backend start; resets to 0 automatically
RESET_PWD=0
# Comma-separated IPs of this machine. Actions targeting these IPs run locally (no SSH).
# Requires mounting the Docker socket — see docker-compose.local.yml.
# Example: LOCAL_HOST_IPS=192.168.1.41
LOCAL_HOST_IPS=

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# Place your certificate and private key in config/certs/:
#   config/certs/cert.pem   (certificate + chain)
#   config/certs/key.pem    (private key)
# The frontend container detects these files on startup and enables HTTPS automatically.
# HTTP traffic is then redirected to HTTPS.
#
# To obtain a free certificate with Certbot (Let's Encrypt):
#   certbot certonly --standalone -d yourdomain.com
#   cp /etc/letsencrypt/live/yourdomain.com/fullchain.pem config/certs/cert.pem
#   cp /etc/letsencrypt/live/yourdomain.com/privkey.pem   config/certs/key.pem
#
# Alternatively, terminate TLS at a reverse proxy (Caddy, Traefik, Cloudflare Tunnel)
# and leave config/certs/ empty.

# ── Two-factor authentication ────────────────────────────────────────────────
# CIDR range of your intranet — requests from this range bypass 2FA.
# Leave empty to require 2FA for all access (including localhost).
# Example: INTRANET_CIDR=192.168.1.0/24
INTRANET_CIDR=
# Email address that receives the 2FA code
TWO_FA_EMAIL=admin@example.com
# How many days a verified device is trusted before re-verification is required
TWO_FA_VALIDITY_DAYS=30
# SMTP settings for sending the verification email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = direct SSL (port 465), false = STARTTLS (port 587). Defaults to auto-detect by port.
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASS=
SMTP_FROM=dashboard@example.com
