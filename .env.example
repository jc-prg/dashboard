# Copy this file to .env and fill in your values
# .env is excluded from git

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
FRONTEND_PORT=80
# Set to 1 to generate a new random password on next backend start; resets to 0 automatically
RESET_PWD=0
# Comma-separated IPs of this machine. Actions targeting these IPs run locally (no SSH).
# Example: LOCAL_HOST_IPS=192.168.1.41
LOCAL_HOST_IPS=

# ── Two-factor authentication ────────────────────────────────────────────────
# CIDR range of your intranet — requests from this range bypass 2FA.
# Leave empty to require 2FA for all access (including localhost).
# Example: INTRANET_CIDR=192.168.1.0/24
INTRANET_CIDR=
# Email address that receives the 2FA code
TWO_FA_EMAIL=admin@example.com
# How many days a verified device is trusted before re-verification is required
TWO_FA_VALIDITY_DAYS=30
# SMTP settings for sending the verification email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=
SMTP_FROM=dashboard@example.com
